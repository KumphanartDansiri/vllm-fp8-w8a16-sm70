# vLLM 0.19.0 from source for V100 (sm_70) — IDENTICAL to Dockerfile.vllm019_py312
# EXCEPT the CUDA stack is cu126 instead of cu128. This is the controlled probe
# for the "cu128 -> cu126 lost efficiency" hypothesis: hold the ENGINE (vLLM
# 0.19) and the torch VERSION (2.10.0) constant, vary ONLY the CUDA runtime.
#
#   0.19 + torch 2.10.0+cu128  -> 27.74 tok/s (122B-FP8 cudagraph, measured)
#   0.19 + torch 2.10.0+cu126  -> THIS IMAGE (compare directly)
#   0.21 + torch 2.11.0+cu126  -> 23.93 tok/s
#
# If this image measures ~24 -> cu126 is the cost (unavoidable on the Volta-
# capable stack). If it stays ~27.74 -> cu126 is innocent; the 0.21 engine (or
# torch 2.11) owns the regression.
#
# No code patch and no pin override: 0.19 pins torch==2.10.0, and 2.10.0+cu126
# wheels exist — we just point the index at cu126. CUDA 12.6 base also keeps the
# CMake <12.8 else-branch that lists sm_70 (same reasoning as the 0.21 image).
#
# Build (context = the vllm-0.19 source tree):
#   docker build -f docker/Dockerfile.vllm019_cu126 -t vllm-v100-py312:vllm019-cu126 ~/vllm-0.19

FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-dev python3-pip \
        gcc g++ git cmake ninja-build \
        curl ca-certificates libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# THE ONLY REAL CHANGE vs the cu128 image: torch 2.10.0 from the cu126 index.
RUN python3 -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.10.0

WORKDIR /vllm-src
COPY . /vllm-src

RUN python3 -m pip install --no-cache-dir -r requirements/build.txt

ARG MAX_JOBS=8
ENV TORCH_CUDA_ARCH_LIST="7.0" \
    VLLM_TARGET_DEVICE=cuda \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.19.0 \
    MAX_JOBS=${MAX_JOBS} \
    CMAKE_BUILD_TYPE=Release \
    NVCC_THREADS=2
RUN python3 -m pip install --no-cache-dir --no-build-isolation -v .

# Import smoke only. NOTE: torch.cuda.get_arch_list() returns [] in a no-GPU
# docker build (CUDA can't init), so we do NOT assert sm_70 here — the real
# sm_70 verification is done at runtime with --gpus (see the smoke scripts).
RUN python3 -c "import torch, vllm; print('vllm:', vllm.__version__, '| torch:', torch.__version__, '| arch_list(empty-in-build-is-normal):', torch.cuda.get_arch_list())"

WORKDIR /work
