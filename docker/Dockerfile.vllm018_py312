# Stock vLLM 0.18.0 on Python 3.12 + torch 2.10.0+cu128, to test whether the
# standalone_compile.FakeTensorMode AttributeError observed under py3.10 goes
# away on py3.12 (per the comment at vllm/compilation/compiler_interface.py:377
# admitting the bug is Python ≤3.10 specific). If cudagraph captures here, we
# have a cheap migration path: rebuild our existing cu128 stack on py3.12
# without forking vllm or losing the fp8_w8a16_sm70 monkey-patches.
#
# Held constant vs our current Dockerfile.dev:
#   * vllm version: 0.18.0
#   * torch version: 2.10.0+cu128 (matches vllm 0.18's torch ABI)
#   * transformers: 4.57.6
#
# Changed:
#   * Python: 3.10 -> 3.12 (Ubuntu 22.04 -> 24.04 base)
#   * No fp8_w8a16_sm70 monkey-patches yet — first test is cudagraph alone
#     on a non-FP8 model (Qwen2.5-7B). Add patches once cudagraph confirmed.
#
# Build:   ./docker/run_docker_vllm018_py312.sh build
# Serve:   ./docker/run_docker_vllm018_py312.sh serve <vllm serve args...>

# Devel base (not -base-) is required so /usr/local/cuda/bin/nvcc is
# available — needed by torch.utils.cpp_extension JIT to compile our
# fp8_dequant.cu kernel at first serve-fp8 launch. Adds ~3 GB image size.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Ubuntu 24.04 ships python3.12 as the system python. gcc/g++ needed for
# triton JIT (same as Dockerfile.1catai).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-dev python3-pip \
        gcc g++ \
        curl ca-certificates libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Torch 2.10.0+cu128 — matches what vllm 0.18 was built against. Held
# constant from our cu128 Dockerfile.dev so the only changed variable is
# Python version.
RUN python3 -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.10.0

# Stock vllm 0.18.0 from PyPI. Pip pulls remaining deps (transformers, etc.)
# automatically; the pinned torch above satisfies vllm's torch requirement.
RUN python3 -m pip install --no-cache-dir \
        vllm==0.18.0 \
        safetensors>=0.4

# Smoke test: confirm vllm imports and reports the expected version on py3.12.
RUN python3 -c "import torch; import vllm; print('vllm:', vllm.__version__, '| torch:', torch.__version__, '| py:', __import__('sys').version.split()[0])"

WORKDIR /work
